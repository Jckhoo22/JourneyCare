# Firebase web config for the Journey Care app (project: car-log-project).
# These are public web identifiers, not secrets — .env is convenience, not secrecy.
# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=""
# Setting this to the app's OWN hosting host (car-log-project.web.app) makes
# Firebase's /__/auth handler same-origin, which is what lets Google
# signInWithRedirect survive third-party-cookie blocking on iOS Safari. While
# it points at …firebaseapp.com the app uses a popup on every device instead.
# See docs/auth-redirect.md before changing it — it needs a Google Cloud
# console change too.
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# The origin invite URLs and QR codes are built from. Set to the deployed
# app's host so a QR rendered on a dev laptop still scans correctly from a
# phone — the sacred /join/:groupId/:token deep-link is walkable end to end
# regardless of where the code was rendered. Defaults to the production
# host if unset; leave blank in production too.
VITE_APP_ORIGIN="https://car-log-project.web.app"
